{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "electron desktop",
    "desktop:dist": "npm run desktop:build && electron-builder --win",
    "desktop:icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "gpt-tokenizer": "^4.0.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "pdf-to-img": "^7.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sqlite-vec": "^0.1.9",
    "swr": "^2.5.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.secondbrain.app",
    "productName": "Second Brain",
    "directories": {
      "app": "desktop",
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json",
      "icon.png",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Second Brain",
      "runAfterFinish": true,
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico"
    },
    "afterPack": "./scripts/after-pack.cjs"
  },
  "overrides": {
    "pdf-to-img": {
      "pdfjs-dist": "$pdfjs-dist"
    }
  }
}
